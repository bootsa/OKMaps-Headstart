{
  "compilerOptions": {
    "target": "ES2015",
    "allowJs": true,
    "lib": ["es2022", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@js/*": ["src/js/*"],
      "markjs": ["mark.js/dist/jquery.mark.js"],
      "hypher": ["hypher/dist/jquery.hypher.js"]
    }
  },
  "include": ["src/**/*"]
}
