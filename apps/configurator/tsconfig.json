{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUnusedLocals": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "vite/client"],
		"allowImportingTsExtensions": true
	},
	"include": ["src", "test", "vite.config.ts"]
}
