{
	"name": "okmaps",
	"version": "7.1.29",
	"private": true,
	"description": "Head Start presents you with the main areas in the field, and lets you zoom into the most important publications within each area. It is intended to give researchers that are new to a field a head start on their literature review (hence the name).",
	"license": "MIT",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bootsa/OKMaps-Headstart.git"
	},
	"scripts": {
		"build": "pnpm --filter @okmaps/frontend build",
		"dev": "pnpm --filter @okmaps/frontend dev",
		"test": "pnpm -r --workspace-concurrency=1 test",
		"typecheck": "pnpm -r typecheck",
		"test:browser": "pnpm --filter @okmaps/frontend test:browser",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2"
	}
}
