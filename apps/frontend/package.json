{
	"name": "@okmaps/frontend",
	"version": "0.1.0",
	"description": "OKMaps in the browser: searches a provider, builds the map in a Web Worker, keeps maps in IndexedDB and shows them with @okmaps/ui-svelte.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:browser": "node scripts/browser-test.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@okmaps/gateway": "workspace:*",
		"@okmaps/ui-svelte": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.10.0",
		"jose": "^6.2.16",
		"playwright": "1.65.0",
		"svelte": "^5.57.3",
		"typescript": "^5.7.2",
		"vite": "8.3.6",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@inrupt/solid-client-authn-browser": "^5.0.3",
		"@okmaps/pipeline": "workspace:*",
		"@okmaps/sources": "workspace:*",
		"@okmaps/storage": "workspace:*"
	}
}
