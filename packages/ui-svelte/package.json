{
	"name": "@okmaps/ui-svelte",
	"version": "0.1.0",
	"description": "The new OKMaps interface in Svelte 5: design tokens in plain CSS, components documented in Storybook. Replaces @okmaps/ui once it matches it.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./styles.css": "./src/styles/index.css"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build -o storybook-static"
	},
	"engines": {
		"node": ">=22.18"
	},
	"peerDependencies": {
		"svelte": "^5.46.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/addon-docs": "^10.6.6",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/svelte": "^10.6.6",
		"@storybook/svelte-vite": "^10.6.6",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/leaflet": "^1.9.22",
		"jsdom": "^31.0.0",
		"storybook": "^10.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@citation-js/core": "^0.9.0",
		"@citation-js/plugin-csl": "^0.9.0",
		"@okmaps/core": "workspace:*",
		"@okmaps/pipeline": "workspace:*",
		"@okmaps/storage": "workspace:*",
		"d3-array": "^3.2.5",
		"d3-scale": "^4.0.3",
		"d3-shape": "^3.2.1",
		"leaflet": "^1.9.4"
	}
}
