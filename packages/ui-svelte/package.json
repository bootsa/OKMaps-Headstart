{
  "name": "@okmaps/ui-svelte",
  "version": "0.1.0",
  "description": "The new OKMaps interface in Svelte 5: design tokens in plain CSS, components documented in Storybook. Replaces @okmaps/ui once it matches it.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "svelte": "^5.46.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/svelte": "^10.6.6",
    "@storybook/svelte-vite": "^10.6.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^26.1.0",
    "storybook": "^10.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
