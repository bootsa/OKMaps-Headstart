{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"types": ["vitest/globals", "svelte", "node"]
	},
	"include": ["src/**/*", "test/**/*", "*.config.ts", "scripts/**/*", "../ui-svelte/src/assets.d.ts"]
}
