{
	"$schema": "../schema.json",
	"site": {
		"title": "Biomed Maps",
		"lead": "Knowledge maps of PubMed topics, kept in this browser."
	},
	"sources": { "offer": ["pubmed"], "types": [] },
	"stores": { "types": ["browser"] },
	"views": ["overview"],
	"features": {
		"settingsPage": false,
