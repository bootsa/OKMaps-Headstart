{
	"name": "@okmaps/pipeline",
	"version": "0.1.0",
	"description": "OKMaps map-building pipeline (text processing, similarity, clustering, layout, area labels) in TypeScript. Runs in the browser (Web Worker) and in Node.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./streamgraph": "./src/streamgraph/index.ts"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"smoke:browser": "node scripts/browser-smoke.ts"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "^5.7.2",
		"esbuild": "^0.25.0",
		"playwright": "1.63.0",
		"vitest": "^3.2.4"
	}
}
